# =============================================================================
# VulnScanner - Optional Environment Configuration
# Copy this file to .env and customize as needed.
# =============================================================================

# --- Server & Authentication ---
BIND_HOST=127.0.0.1
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Report & Authorisation Signing ---
# If omitted, a random key is generated and persisted in data/signing.key
REPORT_SIGNING_KEY=

# --- Database & Retention ---
VULNSCANNER_DB=data/vulnscanner.db
RETENTION_DAYS=90

# --- NVD API Key (optional, increases CVE lookup rate limit) ---
NVD_API_KEY=

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Outbound Event Webhooks (optional, HMAC-signed) ---
EVENT_WEBHOOK_URL=

# --- Issue Tracker Integrations (optional) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_URL=https://gitlab.com

JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
